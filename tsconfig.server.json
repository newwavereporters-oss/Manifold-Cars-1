{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "api/**/*.ts",
    "api/**/*.d.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "api/_server.mjs"
  ]
}
