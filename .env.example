# GEMINI_API_KEY: Required for Gemini Market Intelligence extraction & vector embeddings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI Server-Side Integration (Phase 2 — Never expose to VITE_ browser env)
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Authentication & Database Configuration
# Connect your Supabase project (Project URL and Anon/Publishable Key from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
